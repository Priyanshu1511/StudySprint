  const base=String(file.name||'photo').replace(/\.[^.]+$/,'')||'photo';
  return new File([blob],base+extension,{type:outputType,lastModified:Date.now()});
 }catch(err){console.warn('Photo compression skipped; uploading original file.',err);return file}
 finally{if(objectUrl)URL.revokeObjectURL(objectUrl)}
}
async function ssUpload(file,folder){
 const uploadFile=await ssCompressImage(file);
 // Apply the storage upload limit to the actual file being uploaded, after compression.
 if(uploadFile.size>25*1024*1024)throw Error("File must be under 25 MB after compression.");
 const path=folder+"/"+Date.now()+"-"+Math.random().toString(36).slice(2,9)+"-"+String(uploadFile.name||"upload").replace(/[^a-zA-Z0-9._-]/g,"_");
 const r=await ssSupabase.storage.from(ssBucket).upload(path,uploadFile,{contentType:uploadFile.type||"application/octet-stream"});
 if(r.error)throw r.error;
 return {path,url:ssSupabase.storage.from(ssBucket).getPublicUrl(path).data.publicUrl,originalSize:file.size,uploadedSize:uploadFile.size,compressed:uploadFile!==file};
}
async function ssDelete(path){if(path){const r=await ssSupabase.storage.from(ssBucket).remove([path]);if(r.error)throw r.error}}
async function ssPersistNow(){
 if(!ssReady||ssRemote)return false;
 clearTimeout(ssTimer);
 const badge=document.getElementById("cloudStatus");
 const job=async()=>{
  ssSaving=true;
  try{
   let attempts=0;
   do{
    const version=ssRevision;
    const snapshot=JSON.parse(JSON.stringify(state));
    if(badge)badge.textContent="Saving to cloud…";
    const r=await ssSupabase.from("shared_content").upsert({id:1,content:snapshot},{onConflict:"id"});
    if(r.error)throw r.error;
    ssPersistedRevision=version;
    attempts++;
    if(version===ssRevision){if(badge)badge.textContent="Cloud synced";break}
    if(badge)badge.textContent="Saving latest changes…";
   }while(attempts<10);
   if(ssPersistedRevision!==ssRevision){if(badge)badge.textContent="Changes still pending — retrying";ssSave()}
   return ssPersistedRevision===ssRevision;
  }catch(err){
   console.error("[StudySprint] Cloud save failed",err);
   if(badge)badge.textContent="Cloud sync error — export backup";
   return false;
  }finally{ssSaving=false}
 };
 ssSaveQueue=ssSaveQueue.then(job,job);
 return ssSaveQueue;
}
function ssSave(){
 if(!ssReady||ssRemote)return;
 ssRevision++;
 try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){console.error("[StudySprint] Local backup failed",e)}
 clearTimeout(ssTimer);
 const badge=document.getElementById("cloudStatus");
 if(badge)badge.textContent="Changes pending…";
 ssTimer=setTimeout(()=>{ssPersistNow()},300);
}
async function ssRenderAll(){localStorage.setItem(KEY,JSON.stringify(state));renderDashboard();renderLectures();renderMocks();renderSona();if(typeof renderManifestation==='function')renderManifestation();if(typeof renderPersonal==="function")renderPersonal();if(typeof renderVoiceList==="function")renderVoiceList();if(typeof renderMediaGallery==="function")renderMediaGallery()}
function ssAcceptRemote(incoming){
 if(!incoming||typeof incoming!=="object")return;
 // Never replace local edits while a debounce or cloud write is pending.
 if(ssRevision!==ssPersistedRevision||ssSaving){
  console.warn("[StudySprint] Incoming cloud update deferred; local edits are pending.");
  ssSave();return;
 }
 const before=JSON.stringify(state);
 ssRemote=true;
 // Merge remote and local records instead of replacing the entire local state.
 state=ssNormalizeState(ssMergeStates(incoming,state));
 ensureLegacyRewards();
 const mergedDiffersFromCloud=JSON.stringify(state)!==JSON.stringify(ssNormalizeState(JSON.parse(JSON.stringify(incoming))));
 ssRenderAll().catch(e=>console.error("[StudySprint] Render remote state failed",e)).finally(()=>{
  ssRemote=false;
  if(document.getElementById("cloudStatus"))document.getElementById("cloudStatus").textContent="Cloud synced";
  if(mergedDiffersFromCloud||JSON.stringify(state)!==before)ssSave();
 });
}
async function ssStart(){
 const badge=document.getElementById("cloudStatus");
 try{
  const r=await ssSupabase.from("shared_content").select("id,content").eq("id",1).maybeSingle();
  if(r.error)throw r.error;
  const local=(()=>{try{return JSON.parse(localStorage.getItem(KEY)||"null")}catch{return null}})();
  if(r.data?.content){
   const cloud=ssNormalizeState(r.data.content);
   const merged=ssMergeStates(cloud,local);
   ssRemote=true;state=ssNormalizeState(merged);ensureLegacyRewards();await ssRenderAll();ssRemote=false;
   ssReady=true;ssRevision++;await ssPersistNow();
  }else{
   state=ssNormalizeState(state);ensureLegacyRewards();
   const w=await ssSupabase.from("shared_content").upsert({id:1,content:state},{onConflict:"id"});
   if(w.error)throw w.error;
   ssReady=true;ssRevision=0;ssPersistedRevision=0;
  }
  if(badge)badge.textContent="Cloud connected";
  if(!ssChannelReady){
   ssChannelReady=true;
   ssSupabase.channel("ss-shared").on("postgres_changes",{event:"*",schema:"public",table:"shared_content",filter:"id=eq.1"},p=>{
    if(!p.new?.content)return;
    const incoming=p.new.content;
    // Ignore the realtime echo of our own just-persisted snapshot.
    if(ssSaving||ssRevision!==ssPersistedRevision){console.warn("[StudySprint] Ignored cloud echo while local changes are pending.");return}
    const current=JSON.stringify(state),remote=JSON.stringify(incoming);
    if(current===remote)return;
    ssAcceptRemote(incoming);
   }).subscribe(status=>{if(status==="SUBSCRIBED"&&badge&&ssRevision===ssPersistedRevision)badge.textContent="Cloud synced"});
  }
 }catch(e){
  ssRemote=false;console.error("[StudySprint] Supabase setup/sync failed",e);
  if(badge)badge.textContent="Cloud error — local data retained";
 }
}
</script>

<script>
const KEY='studysprint_exam_tracker_v1';
const subjects=['Reasoning','Maths','English'];
const branches=['Physical Geography','Climatology','Oceanography','Human Geography','Indian Geography','World Geography','Economic Geography','Environmental Geography','Biogeography'];
const platforms=['Testbook','Oliveboard'];
let state=loadState(), currentPage='dashboard', editorKind='', editId=null;
['calls','meetups','diary','messages','habits','priyanshuHabits','voiceMeta','mediaMeta','libraryAttendance','rewardEvents'].forEach(k=>{if(!Array.isArray(state[k]))state[k]=[];});
let voiceRecorder=null, voiceChunks=[], voiceStream=null;
function uid(){return Math.random().toString(36).slice(2,10)+Date.now().toString(36)}
function freshState(){let lectures=[];subjects.forEach(subject=>{for(let n=1;n<=50;n++)lectures.push({id:uid(),subject,num:n,topic:'',pdf:'',done:false,r1:'',r2:'',r3:''})});return {lectures,mocks:[],topics:[],activity:[]}}
function loadState(){try{let s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.lectures)&&Array.isArray(s.mocks)&&Array.isArray(s.topics))return s}catch(e){}return freshState()}
function save(){localStorage.setItem(KEY,JSON.stringify(state));if(window.ssSave)ssSave();renderDashboard();renderLectures();renderMocks();renderSona();if(typeof renderManifestation==='function')renderManifestation();if(typeof renderPersonal==='function')renderPersonal();if(typeof renderMediaGallery==='function')renderMediaGallery();}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function notify(msg){let t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)}
const REWARD_TARGETS={Sona:{daily:40,weekly:250,monthly:1000},Priyanshu:{daily:40,weekly:250,monthly:1000}};
function rewardOwnerFromText(text){
 const t=String(text||'');
 if(/\bSona\b/i.test(t)) return 'Sona';
 if(/\bPriyanshu\b/i.test(t)) return 'Priyanshu';
 if(/^Completed .+ lecture /i.test(t)||/^Completed revision /i.test(t)||/^Logged mock test:/i.test(t)||/^Added Geography topic:/i.test(t)) return /^Added Geography topic:/i.test(t)?'Sona':'Priyanshu';
 return 'Priyanshu';
}
function pointsForActivity(text){
 const t=String(text||'');
 if(/^Completed .+ lecture /i.test(t)) return 10;
 if(/^Completed revision /i.test(t)) return 5;
 if(/^Logged mock test:/i.test(t)) return 20;
 if(/^Added Geography topic:/i.test(t)) return 10;
 if(/checked in at the library/i.test(t)) return 5;
 if(/checked out of the library/i.test(t)) return 10;
 if(/^Saved daily wellness log /i.test(t)){const m=t.match(/\((\d+) habits\)/i);return m?Number(m[1])*2:0}
 if(/^Completed manifestation activity/i.test(t)) return 5;
 return 0;
}
function awardPoints(owner,text,points,time=new Date().toISOString(),sourceKey=''){
 if(!['Sona','Priyanshu'].includes(owner)||!Number(points))return;
 state.rewardEvents=state.rewardEvents||[];
 const key=sourceKey||`event:${owner}:${text}:${time}`;
 if(state.rewardEvents.some(x=>x.key===key))return;
 state.rewardEvents.unshift({id:uid(),key,owner,text,points:Number(points),time:time||null,legacy:!time});
}
function addActivity(text, ownerOverride=null, sourceKey=''){
 const time=new Date().toISOString();
 state.activity.unshift({text,time});state.activity=state.activity.slice(0,8);
 const points=pointsForActivity(text);
 const owner=ownerOverride||rewardOwnerFromText(text);
 if(points>0)awardPoints(owner,text,points,time,sourceKey||`activity:${uid()}`);
}
function ensureLegacyRewards(){
 // V7 is deliberately idempotent: preserve live awards, rebuild legacy awards from source records.
 if(!Array.isArray(state.rewardEvents))state.rewardEvents=[];
 if(state.rewardMigrationV7)return;
 state.rewardEvents=state.rewardEvents.filter(e=>!e.legacy);
 const checked=v=>v===true||v===1||String(v).toLowerCase()==='true'||String(v).toLowerCase()==='yes'||String(v)==='1';
 const stamp=v=>{if(!v)return null;const d=new Date(v);return Number.isNaN(d.getTime())?null:d.toISOString()};
 const addLegacy=(owner,source,id,text,points,date)=>{
   if(!['Sona','Priyanshu'].includes(owner)||!Number(points))return;
   const key=`legacy:v7:${source}:${String(id)}`;
   if(state.rewardEvents.some(e=>e.key===key))return;
   state.rewardEvents.push({id:uid(),key,owner,text,points:Number(points),time:stamp(date),legacy:true});
 };
 (state.lectures||[]).forEach((x,i)=>{
   const id=x.id??`${x.subject||'subject'}:${x.num??i}`;
   if(checked(x.done))addLegacy('Priyanshu','lecture',id,`Existing completed lecture: ${x.subject||''} ${x.num??''}`.trim(),10,x.completedAt||x.doneAt||x.updatedAt||null);
   ['r1','r2','r3'].forEach(k=>{if(checked(x[k])||(typeof x[k]==='string'&&/^\d{4}-\d{2}-\d{2}/.test(x[k])))addLegacy('Priyanshu','revision',`${id}:${k}`,`Existing revision ${k.toUpperCase()}: ${x.subject||''} ${x.num??''}`.trim(),5,typeof x[k]==='string'&&/^\d{4}-\d{2}-\d{2}/.test(x[k])?x[k]:null)});
 });
 (state.mocks||[]).forEach((x,i)=>addLegacy('Priyanshu','mock',x.id??`${x.name||'mock'}:${x.date||x.createdAt||i}`,`Existing mock test: ${x.name||'Mock test'}`,20,x.createdAt||x.date||null));
 (state.topics||[]).forEach((x,i)=>addLegacy('Sona','geography',x.id??`${x.branch||''}:${x.topic||i}:${x.date||''}`,`Existing Geography topic: ${x.topic||'Geography topic'}`,10,x.createdAt||x.date||x.updatedAt||null));
 const habitKeys=['aloe','yoga','meditation','sunwater','temple','balanced','water','revision','walk'];
 (state.habits||[]).forEach((x,i)=>{const n=habitKeys.filter(k=>checked(x[k])).length;if(n)addLegacy('Sona','wellness',x.id??`${x.date||'undated'}:${i}`,`Existing wellness: ${n}/9 habits`,n*2,x.date||x.createdAt||x.updatedAt||null)});
 (state.priyanshuHabits||[]).forEach((x,i)=>{const n=habitKeys.filter(k=>checked(x[k])).length;if(n)addLegacy('Priyanshu','wellness',x.id??`${x.date||'undated'}:${i}`,`Existing wellness: ${n}/9 habits`,n*2,x.date||x.createdAt||x.updatedAt||null)});
 (state.libraryAttendance||[]).forEach((x,i)=>{const raw=String(x.person||'').trim().toLowerCase();const owner=raw==='sona'?'Sona':raw==='priyanshu'?'Priyanshu':null;if(!owner)return;const id=x.id??`${owner}:${x.date||''}:${x.checkIn||''}:${x.checkOut||''}:${i}`;if(x.checkIn)addLegacy(owner,'library-in',id,`Existing library check-in`,5,x.checkIn||x.date||null);if(x.checkOut)addLegacy(owner,'library-out',id,`Existing library check-out`,10,x.checkOut||x.date||null)});
 (state.manifestationLogs||[]).forEach((x,i)=>{if(checked(x.completed)){const owner=String(x.person||'').toLowerCase()==='sona'?'Sona':'Priyanshu';addLegacy(owner,'manifestation',x.id??`${owner}:${x.date||i}`,`Existing manifestation activity`,5,x.completedAt||x.date||null)}});
 // Older data may have study actions only in activity. Use these only if the matching source collection is absent,
 // preventing a source record and its activity log from earning twice.
 (state.activity||[]).forEach((x,i)=>{
   const text=String(x.text||''), points=pointsForActivity(text);if(!points)return;
   let owner=rewardOwnerFromText(text),source='activity';
   if(/^Completed .+ lecture /i.test(text)&&!(state.lectures||[]).some(v=>checked(v.done)))source='activity-lecture';
   else if(/^Completed revision /i.test(text)&&!(state.lectures||[]).some(v=>['r1','r2','r3'].some(k=>checked(v[k]))))source='activity-revision';
   else if(/^Logged mock test:/i.test(text)&&!(state.mocks||[]).length)source='activity-mock';
   else if(/^Added Geography topic:/i.test(text)&&!(state.topics||[]).length)source='activity-geography';
   else if(/checked in at the library/i.test(text)&&!(state.libraryAttendance||[]).length)source='activity-library-in';
   else if(/checked out of the library/i.test(text)&&!(state.libraryAttendance||[]).length)source='activity-library-out';
   else if(/^Saved daily wellness log /i.test(text)&&!(state.habits||[]).length&&!(state.priyanshuHabits||[]).length)source='activity-wellness';
   else if(/^Completed manifestation activity/i.test(text)&&!(state.manifestationLogs||[]).length)source='activity-manifestation';
   else return;
   addLegacy(owner,source,`${i}:${x.time||text}`,text,points,x.time||null);
 });
 state.rewardMigrationV7=true;
}
function revCount(x){return [x.r1,x.r2,x.r3].filter(Boolean).length}
function pct(a,b){return Number(b)>0&&a!==''?Number(a)/Number(b)*100:null}
function avg(arr){let nums=arr.filter(v=>Number.isFinite(v));return nums.length?nums.reduce((a,b)=>a+b,0)/nums.length:null}
function fmt(v){return v===null||!Number.isFinite(v)?'—':v.toFixed(1)+'%'}
function dateLabel(d){try{return new Date(d).toLocaleDateString(undefined,{day:'numeric',month:'short'})}catch(e){return ''}}
function dateTimeLabel(d){try{return new Date(d).toLocaleString(undefined,{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'})}catch(e){return ''}}
function renderRewards(){
 const events=Array.isArray(state.rewardEvents)?state.rewardEvents:[];
 const today=localDateISO();
 const now=new Date();
 const weekStart=new Date(now.getFullYear(),now.getMonth(),now.getDate());
 const dow=(weekStart.getDay()+6)%7;weekStart.setDate(weekStart.getDate()-dow);weekStart.setHours(0,0,0,0);
 const monthStart=new Date(now.getFullYear(),now.getMonth(),1);monthStart.setHours(0,0,0,0);
 const eventDate=e=>{if(!e.time)return null;const d=new Date(e.time);return Number.isNaN(d.getTime())?null:d};
 const sum=(person,pred=()=>true)=>events.filter(e=>e.owner===person&&pred(e)).reduce((n,e)=>n+(Number(e.points)||0),0);
 for(const person of ['Sona','Priyanshu']){
   const key=person==='Sona'?'sona':'priyanshu';
   const daily=sum(person,e=>{const d=eventDate(e);return d&&localDateISO(d)===today});
   const weekly=sum(person,e=>{const d=eventDate(e);return d&&d>=weekStart&&d<=now});
   const monthly=sum(person,e=>{const d=eventDate(e);return d&&d>=monthStart&&d<=now});
   const total=sum(person);
   const dated=events.filter(e=>e.owner===person&&eventDate(e));
   const first=dated.length?Math.min(...dated.map(e=>eventDate(e).getTime())):now.getTime();
   const days=Math.max(1,Math.floor((now.getTime()-first)/86400000)+1);
   const set=(id,val)=>{const el=document.getElementById(id);if(el)el.textContent=val};
   set(key+'PointsDaily',`${daily} pts`);set(key+'PointsWeekly',`${weekly} pts`);set(key+'PointsMonthly',`${monthly} pts`);set(key+'PointsTotal',`${total} pts`);set(key+'PointsAverage',`${(total/days).toFixed(1)} pts`);
   const targets=REWARD_TARGETS[person]||{daily:40,weekly:250,monthly:1000};
   set(key+'WeeklyTargetLabel',`Target: ${targets.weekly} pts`);set(key+'MonthlyTargetLabel',`Target: ${targets.monthly} pts`);set(key+'TargetLabel',`Daily target: ${targets.daily} pts`);
   const bar=document.getElementById(key+'DailyTargetBar');if(bar)bar.style.width=`${Math.min(100,daily/targets.daily*100)}%`;
 }
 const history=document.getElementById('rewardHistory');
 if(history){const recent=events.slice().sort((a,b)=>(eventDate(b)?.getTime()||0)-(eventDate(a)?.getTime()||0)).slice(0,12);history.innerHTML=recent.length?recent.map(e=>`<div class="record" style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)"><div><strong>${esc(e.owner||'')}</strong><div class="record-meta">${esc(e.text||'Reward')} · ${e.time?esc(dateLabel(e.time)):'Date not saved'}</div></div><span class="tag green">+${Number(e.points)||0} pts</span></div>`).join(''):'<div class="empty">No reward points yet. Existing eligible study, library and wellness records will appear here after migration.</div>'}
}
function renderDashboard(){
 let completed=state.lectures.filter(x=>x.done).length,revisions=state.lectures.reduce((a,x)=>a+revCount(x),0);
 document.getElementById('statCompleted').innerHTML=`${completed} <span style="font-size:15px;color:#8b95a7">/ ${state.lectures.length}</span>`;
 document.getElementById('statRevisions').textContent=revisions;document.getElementById('statMocks').textContent=state.mocks.length;document.getElementById('statTopics').textContent=state.topics.length;
 document.getElementById('subjectProgress').innerHTML=subjects.map((s,i)=>{let arr=state.lectures.filter(x=>x.subject===s),n=arr.filter(x=>x.done).length,p=arr.length?n/arr.length*100:0;return `<div class="progress-row"><div class="progress-top"><strong>${s}</strong><span>${n} of ${arr.length} · ${Math.round(p)}%</span></div><div class="track"><div class="fill ${i===1?'green':i===2?'orange':''}" style="width:${p}%"></div></div></div>`}).join('');
 document.getElementById('platformStats').innerHTML=platforms.map((p,i)=>{let arr=state.mocks.filter(x=>x.platform===p).map(x=>pct(x.score,x.total)).filter(x=>x!==null),a=avg(arr);return `<div class="platform"><span class="tag ${i?'orange':'blue'}">${p}</span><div class="num">${fmt(a)}</div><small>${arr.length} test${arr.length===1?'':'s'} recorded</small></div>`}).join('');
 const branchEmoji={'Physical Geography':'⛰️','Climatology':'🌦️','Oceanography':'🌊','Human Geography':'🏙️','Indian Geography':'🇮🇳','World Geography':'🌍','Economic Geography':'📈','Environmental Geography':'🌱','Biogeography':'🌿'};
 let known=branches.map(b=>({b,n:state.topics.filter(t=>t.branch===b).length})).filter(x=>x.n>0);
 document.getElementById('branchProgress').innerHTML=known.length?known.slice(0,6).map(x=>`<div class="progress-row"><div class="progress-top"><strong>${branchEmoji[x.b]||'◎'} ${esc(x.b)}</strong><span>${x.n} topic${x.n===1?'':'s'}</span></div><div class="track"><div class="fill green" style="width:${Math.min(100,x.n*10)}%"></div></div></div>`).join(''):'<div class="empty"><strong>No Geography topics yet</strong>Add Sona’s first topic to see branch progress here.</div>';
 document.getElementById('activity').innerHTML=state.activity.length?state.activity.slice(0,5).map(a=>`<div style="padding:11px 0;border-bottom:1px solid var(--line);display:flex;gap:10px"><span style="color:var(--blue)">●</span><div><div style="font-size:13px">${esc(a.text)}</div><small style="color:var(--muted)">${dateLabel(a.time)}</small></div></div>`).join(''):'<div class="empty"><strong>Your activity will appear here</strong>Tick a lecture, log a mock or add a Geography topic.</div>';
 renderLibraryAttendance();
 renderRewards();
}
function localDateISO(d=new Date()){const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),day=String(d.getDate()).padStart(2,'0');return `${y}-${m}-${day}`}
function clockLabel(iso){if(!iso)return '—';try{return new Date(iso).toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'})}catch(e){return '—'}}
function attendanceFor(person,date=localDateISO()){return (state.libraryAttendance||[]).find(x=>x.person===person&&x.date===date)}
function renderLibraryAttendance(){
 const today=localDateISO();
 for(const person of ['Priyanshu','Sona']){
  const item=attendanceFor(person,today),prefix=person==='Priyanshu'?'libraryPriyanshu':'librarySona';
  const status=document.getElementById(prefix+'Status'),times=document.getElementById(prefix+'Times');
  if(status)status.textContent=!item?.checkIn?'Not checked in':item?.checkOut?'Checked out':'Checked in';
  if(times)times.textContent=`Check-in ${clockLabel(item?.checkIn)} · Check-out ${clockLabel(item?.checkOut)}`;
  document.querySelectorAll(`[data-library-action][data-person="${person}"]`).forEach(btn=>{const action=btn.dataset.libraryAction;btn.disabled=action==='checkin'?!!item?.checkIn:(!item?.checkIn||!!item?.checkOut);});
 }
 const dashboard=document.getElementById('dashboardLibraryAttendance');
 if(dashboard){dashboard.innerHTML=['Priyanshu','Sona'].map(person=>{const item=attendanceFor(person,today);const status=!item?.checkIn?'Not checked in':item?.checkOut?'Checked out':'Checked in';return `<div style="display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)"><div><strong>${esc(person)}</strong><div class="record-meta">In: ${esc(clockLabel(item?.checkIn))} · Out: ${esc(clockLabel(item?.checkOut))}</div></div><span class="tag ${item?.checkOut?'green':item?.checkIn?'blue':''}">${status}</span></div>`}).join('')}
 const dateFilter=document.getElementById('libraryDateFilter')?.value||'',personFilter=document.getElementById('libraryPersonFilter')?.value||'';
 const rows=(state.libraryAttendance||[]).filter(x=>(!dateFilter||x.date===dateFilter)&&(!personFilter||x.person===personFilter)).slice().sort((a,b)=>b.date.localeCompare(a.date)||a.person.localeCompare(b.person));
 const tbody=document.getElementById('libraryAttendanceRows');
