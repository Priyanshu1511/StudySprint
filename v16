function todayPromptIndex(){const d=new Date();const start=new Date(d.getFullYear(),0,0);return Math.floor((d-start)/86400000)%manifestationPrompts.length}
function renderManifestation(){
 const idx=todayPromptIndex(),p=manifestationPrompts[idx],today=localDateISO();
 const title=document.getElementById('manifestPromptTitle'),meta=document.getElementById('manifestPromptMeta'),txt=document.getElementById('manifestPromptText'),how=document.getElementById('manifestHowTo');
 if(title)title.textContent=`Day ${idx+1}: ${p[0]}`;if(meta)meta.textContent=`${today} · Today's prompt`;
 if(txt)txt.textContent=p[1];if(how)how.textContent=p[2];
 const hist=document.getElementById('manifestationHistory');
 if(hist){const items=(state.manifestationLogs||[]).slice().sort((a,b)=>(b.completedAt||'').localeCompare(a.completedAt||''));hist.innerHTML=items.length?items.map(x=>`<div class="record"><div><strong>${esc(x.person)} · ${esc(x.title)}</strong><div class="record-meta">${esc(x.date||'')} · +5 points</div><p>${esc(x.writing||'')}</p>${x.url?`<a href="${esc(x.url)}" target="_blank" rel="noopener"><img src="${esc(x.url)}" alt="Manifestation writing photo" style="width:100%;max-height:220px;object-fit:cover;border-radius:10px"></a>`:''}</div></div>`).join(''):'<div class="empty">No completed activities yet. Start with today’s prompt.</div>'}
}
document.getElementById('manifestationForm')?.addEventListener('submit',async e=>{
 e.preventDefault();
 const person=document.getElementById('manifestPerson').value,writing=document.getElementById('manifestWriting').value.trim(),file=document.getElementById('manifestPhoto').files[0],date=localDateISO();
 if(writing.length<20){alert('Write at least 20 characters, ideally 3–5 honest sentences.');return}
 if(!file||!file.type.startsWith('image/')){alert('Choose a photo of your written activity first.');return}
 if((state.manifestationLogs||[]).some(x=>x.person===person&&x.date===date)){alert(`${person} has already completed today's manifestation activity. You can review it in the history.`);return}
 const btn=document.getElementById('completeManifestation');if(btn){btn.disabled=true;btn.textContent='Uploading…'}
 try{
  const promptData=manifestationPrompts[todayPromptIndex()];
  const up=await ssUpload(file,'manifestation');
  const record={id:uid(),person,date,title:promptData[0],prompt:promptData[1],writing,path:up.path,url:up.url,completed:true,completedAt:new Date().toISOString()};
  state.manifestationLogs=state.manifestationLogs||[];state.manifestationLogs.unshift(record);
  addActivity('Completed manifestation activity: '+promptData[0],person,'manifestation:'+person+':'+date);
  save();renderManifestation();notify(`${person} completed today's practice (+5 points)`);
  e.target.reset();
 }catch(err){console.error(err);alert('Could not upload the photo or save the activity: '+(err.message||'Unknown error'))}
 finally{if(btn){btn.disabled=false;btn.textContent='Upload photo & complete activity (+5 points)'}}
});

function renderMediaGallery(){const el=document.getElementById('sharedMediaGallery');if(!el)return;const items=(state.mediaMeta||[]).slice().sort((a,b)=>b.created.localeCompare(a.created));el.innerHTML=items.length?items.map(x=>`<div class="record"><a href="${esc(x.url)}" target="_blank" rel="noopener"><img src="${esc(x.url)}" alt="${esc(x.name||"Shared photo")}" style="width:100%;height:150px;object-fit:cover;border-radius:10px"></a><div>${esc(x.name||"Photo")}</div><button class="btn small danger" data-ss-photo-delete="${esc(x.path)}">Delete</button></div>`).join(''):'<div class="empty">No shared photos yet.</div>'}
