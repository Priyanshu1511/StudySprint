/* Voice recordings are stored in IndexedDB, not localStorage, to allow larger audio blobs. */
let voiceDbPromise=null;
function voiceDb(){if(voiceDbPromise)return voiceDbPromise;voiceDbPromise=new Promise((resolve,reject)=>{let req=indexedDB.open('StudySprintVoiceDB',1);req.onupgradeneeded=()=>req.result.createObjectStore('audio',{keyPath:'id'});req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)});return voiceDbPromise}
async function putAudio(record){let db=await voiceDb();return new Promise((resolve,reject)=>{let tx=db.transaction('audio','readwrite');tx.objectStore('audio').put(record);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}
async function getAudio(id){let db=await voiceDb();return new Promise((resolve,reject)=>{let req=db.transaction('audio','readonly').objectStore('audio').get(id);req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)})}
async function deleteAudio(id){let db=await voiceDb();return new Promise((resolve,reject)=>{let tx=db.transaction('audio','readwrite');tx.objectStore('audio').delete(id);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}

