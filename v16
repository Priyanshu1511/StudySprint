document.addEventListener('click',async e=>{const b=e.target.closest('[data-ss-photo-delete]');if(!b)return;if(!confirm('Delete this photo for everyone?'))return;try{await ssDelete(b.dataset.ssPhotoDelete);state.mediaMeta=(state.mediaMeta||[]).filter(x=>x.path!==b.dataset.ssPhotoDelete);save();renderMediaGallery()}catch(e){alert('Delete failed: '+e.message)}});
async function renderVoiceList(){let el=document.getElementById('voiceRecords');if(!el)return;let list=(state.voiceMeta||[]).slice().sort((a,b)=>b.created.localeCompare(a.created));if(!list.length){el.innerHTML='<div class="empty"><strong>No voice notes yet</strong>Record or upload a voice note to start your library.</div>';return}el.innerHTML='';for(let x of list){let article=document.createElement('article');article.className='record';article.innerHTML=`<div class="record-head"><div><h4>♫ ${esc(x.caption||'Voice message')} · ${esc(x.from)} → ${esc(x.to)}</h4><div class="record-meta">${dateLabel(x.created)} · ${esc(x.source||'Recorded audio')}</div></div></div><div class="audio-row" style="margin-top:12px"><audio controls></audio><a class="btn small" download="${esc((x.caption||'voice-message').replace(/[^a-z0-9-_]/gi,'_'))}.webm">Download audio</a><button class="btn small danger">Delete</button></div>`;el.appendChild(article);try{let aud=null,url=x.url||'';if(!url){aud=await getAudio(x.id);if(aud&&aud.blob)url=URL.createObjectURL(aud.blob)}if(url){article.querySelector('audio').src=url;article.querySelector('a').href=url;article.querySelector('button').onclick=async()=>{if(confirm('Delete this voice message?')){if(x.path)await ssDelete(x.path);await deleteAudio(x.id).catch(()=>{});state.voiceMeta=state.voiceMeta.filter(y=>y.id!==x.id);save();notify('Voice note deleted')}}}else{article.querySelector('audio').remove();article.querySelector('a').remove();article.querySelector('button').disabled=true;article.querySelector('button').textContent='Audio unavailable'}}catch(err){article.querySelector('audio').remove()}}}
async function saveVoiceBlob(blob,source='Recorded audio'){let id=uid(),caption=document.getElementById('voiceCaption').value.trim()||'Daily voice message',from=document.getElementById('voiceFrom').value,to=document.getElementById('voiceTo').value;await putAudio({id,blob});const file=new File([blob],id+'.webm',{type:blob.type||'audio/webm'});const u=await ssUpload(file,'voice');state.voiceMeta.unshift({id,caption,from,to,source,path:u.path,url:u.url,created:new Date().toISOString()});addActivity(`${from} saved a voice message for ${to}`,from);save();if(typeof renderVoiceList==='function')await renderVoiceList();notify('Voice recording uploaded and shared')}
document.getElementById('recordVoice').onclick=async()=>{try{if(!navigator.mediaDevices?.getUserMedia||!window.MediaRecorder)throw Error('This browser does not support audio recording. Try a recent Chrome or Edge version on localhost/HTTPS.');voiceStream=await navigator.mediaDevices.getUserMedia({audio:true});voiceChunks=[];voiceRecorder=new MediaRecorder(voiceStream);voiceRecorder.ondataavailable=e=>{if(e.data.size)voiceChunks.push(e.data)};voiceRecorder.onstop=async()=>{let blob=new Blob(voiceChunks,{type:voiceRecorder.mimeType||'audio/webm'});voiceStream?.getTracks().forEach(t=>t.stop());voiceStream=null;try{await saveVoiceBlob(blob)}catch(err){alert('Could not save this audio. Please download a shorter recording or check browser storage.')}document.getElementById('recordVoice').disabled=false;document.getElementById('stopVoice').disabled=true;document.getElementById('recordingState').classList.remove('on')};voiceRecorder.start();document.getElementById('recordVoice').disabled=true;document.getElementById('stopVoice').disabled=false;document.getElementById('recordingState').classList.add('on')}catch(err){alert(err.message||'Microphone permission was not granted.')}}; 
document.getElementById('stopVoice').onclick=()=>{if(voiceRecorder&&voiceRecorder.state!=='inactive')voiceRecorder.stop()};
document.getElementById('saveUploadedVoice').onclick=async()=>{let f=document.getElementById('voiceUpload').files[0];if(!f){alert('Choose an audio file first.');return}try{await saveVoiceBlob(f,'Uploaded audio');document.getElementById('voiceUpload').value=''}catch(e){console.error('Audio upload failed',e);alert('Audio upload failed: '+(e.message||e.error||'Unknown error')+'. Check Storage policies and bucket visibility.')}};

// Read-only diagnostics for DevTools Console. Does not mutate or delete app records.
window.StudySprintTests={
 async runFourRounds(){
  const results=[];
  const checks=async(round)=>{
   const out=[];
   const check=(name,ok,detail="")=>out.push({round,name,status:ok?"PASS":"FAIL",detail});
   check("local state exists",!!state&&typeof state==="object");
   ["lectures","mocks","topics","activity","calls","meetups","diary","messages","habits","priyanshuHabits","libraryAttendance","rewardEvents","manifestationLogs"].forEach(k=>check(`state.${k} is an array`,Array.isArray(state[k]),`count=${Array.isArray(state[k])?state[k].length:"not-array"}`));
   check("reward owners are valid",(state.rewardEvents||[]).every(x=>["Sona","Priyanshu"].includes(x.owner)),`events=${(state.rewardEvents||[]).length}`);
   const keys=(state.rewardEvents||[]).map(x=>x.key).filter(Boolean);
   check("reward keys are unique",keys.length===new Set(keys).size,`keys=${keys.length}`);
   check("reward dashboard nodes exist",!!document.getElementById("sonaPointsTotal")&&!!document.getElementById("priyanshuPointsTotal"));
   check("localStorage parses",(()=>{try{const x=JSON.parse(localStorage.getItem(KEY)||"null");return !!x&&typeof x==="object"}catch{return false}})());
   try{
    const r=await ssSupabase.from("shared_content").select("id,content").eq("id",1).maybeSingle();
    check("Supabase read succeeds",!r.error,r.error?.message||"read-only query");
    check("cloud row id=1 exists",!!r.data?.content,`row=${r.data?.id??"missing"}`);
    if(r.data?.content){
     const cloud=ssNormalizeState(r.data.content);
     ["lectures","topics","habits","priyanshuHabits","libraryAttendance","rewardEvents","manifestationLogs"].forEach(k=>check(`cloud ${k} is an array`,Array.isArray(cloud[k]),`count=${cloud[k].length}`));
     check("cloud reward owners are valid",(cloud.rewardEvents||[]).every(x=>["Sona","Priyanshu"].includes(x.owner)),`events=${cloud.rewardEvents.length}`);
    }
   }catch(e){check("Supabase read succeeds",false,e.message||String(e))}
   return out;
  };
  for(let round=1;round<=4;round++){results.push(...await checks(round));await new Promise(resolve=>setTimeout(resolve,150))}
  console.table(results);
  const failed=results.filter(x=>x.status==="FAIL");
  console.info(`[StudySprint tests] ${results.length-failed.length}/${results.length} checks passed across 4 rounds; failures=${failed.length}`);
  return {passed:results.length-failed.length,failed:failed.length,results};
 }
};
